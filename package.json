{
  "name": "image-charts-documentation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run generate && npm run check:chart-urls && docusaurus build && npm run check:built-chart-urls",
    "build:docs-only": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "generate": "npm run generate:error-codes && npm run generate:google-fonts && npm run generate:gallery",
    "generate:error-codes": "node scripts/generate-error-codes.js",
    "generate:google-fonts": "node scripts/generate-google-fonts.js",
    "generate:gallery": "node scripts/generate-gallery.js",
    "sign:chart-urls": "node scripts/sign-chart-urls.js",
    "check:chart-urls": "node scripts/sign-chart-urls.js --check",
    "check:built-chart-urls": "node scripts/check-built-chart-urls.js",
    "test": "node --test scripts/sign-chart-urls.test.js scripts/check-built-chart-urls.test.js scripts/generate-gallery.test.js"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.2",
    "@mdx-js/react": "^3.0.0",
    "acorn": "8.15.0",
    "clsx": "^2.0.0",
    "entities": "^4.5.0",
    "htmlparser2": "^8.0.2",
    "postcss-value-parser": "4.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "raw-loader": "^4.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "serialize-javascript": "^7.1.3",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
